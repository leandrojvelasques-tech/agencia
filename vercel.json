{
    "buildCommand": "cd eventos-app && npm install && npm run build",
    "outputDirectory": ".",
    "functions": {
        "api/private-report.js": {
            "includeFiles": "private-reports/**"
        }
    },
    "redirects": [
        {
            "source": "/index_en.html",
            "destination": "/en/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/admin/:path*",
            "destination": "/_app/index.html"
        },
        {
            "source": "/evento/:slug",
            "destination": "/api/event-meta?slug=:slug"
        },
        {
            "source": "/evento/:slug/inscripcion",
            "destination": "/api/event-meta?slug=:slug"
        },
        {
            "source": "/evento/:slug/reporte",
            "destination": "/api/event-meta?slug=:slug&isReport=true"
        },
        {
            "source": "/evento/:slug/:subpath*",
            "destination": "/_app/index.html"
        },
        {
            "source": "/presupuesto/:token",
            "destination": "/_app/index.html"
        },
        {
            "source": "/encuesta/:slug",
            "destination": "/_app/index.html"
        },
        {
            "source": "/asistencia/:slug",
            "destination": "/_app/index.html"
        },
        {
            "source": "/presentacion/:id",
            "destination": "/_app/index.html"
        },
        {
            "source": "/clase/:path*",
            "destination": "/_app/index.html"
        },
        {
            "source": "/crm/cliente/:token/:slug*",
            "destination": "/api/event-meta?token=:token"
        },
        {
            "source": "/informes/:token/:reportId",
            "destination": "/api/private-report?token=:token&reportId=:reportId"
        },
        {
            "source": "/informes/:token",
            "destination": "/api/private-report?token=:token"
        },
        {
            "source": "/_app/:path*",
            "destination": "/_app/:path*"
        }
    ]
}
